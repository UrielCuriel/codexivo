{
  "name": "codexivo",
  "version": "0.2.0",
  "description": "Lenguaje de programación en español para practicar lógica y algoritmos, que se ejecuta en el navegador.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "files": [
    "dist",
    "src",
    "!src/cli.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "check": "bun check",
    "repl": "bun run src/cli.ts",
    "build": "bun build ./src/index.ts --target browser --outdir dist --minify --sourcemap=linked"
  },
  "keywords": [
    "lenguaje de programación",
    "español",
    "educación",
    "intérprete"
  ],
  "author": "Uriel Curiel",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UrielCuriel/codexivo.git"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  },
  "packageManager": "bun@1.4.4"
}
