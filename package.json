{
  "name": "codexivo",
  "version": "1.0.2",
  "description": "Lenguaje de programación en español para practicar lógica y algoritmos, que se ejecuta en el navegador.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/worker.js",
    "dist/worker.js.map",
    "src",
    "!src/cli.ts",
    "docs",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./src/worker.ts",
      "import": "./dist/worker.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "check": "bun check",
    "repl": "bun run src/cli.ts",
    "build": "bun run build:lib && bun run build:binary",
    "build:lib": "bun build ./src/index.ts ./src/worker.ts --target browser --format esm --outdir=dist --minify --sourcemap=linked",
    "build:binary": "bun run scripts/build-binaries.ts",
    "build:binaries": "bun run scripts/build-binaries.ts --all",
    "test:package": "bun run scripts/test-package.ts",
    "docs:biblioteca": "bun run scripts/docs-biblioteca.ts",
    "prepack": "bun run build:lib",
    "version": "bun run scripts/sync-native-versions.ts && bun run scripts/changelog.ts && git add package.json bun.lock packages/*/package.json CHANGELOG.md",
    "changelog": "bun run scripts/changelog.ts --imprimir",
    "publish:native": "bun run scripts/publish-native.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "keywords": [
    "lenguaje de programación",
    "español",
    "educación",
    "intérprete"
  ],
  "author": "Uriel Curiel",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UrielCuriel/codexivo.git"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  },
  "packageManager": "bun@1.4.4",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "packages/*"
  ]
}
