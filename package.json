{
  "name": "codexivo",
  "version": "0.2.0",
  "description": "Lenguaje de programación en español para practicar lógica y algoritmos, que se ejecuta en el navegador.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "src",
    "!src/cli.ts",
    "docs",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "bun test",
    "check": "bun check",
    "repl": "bun run src/cli.ts",
    "build": "bun run build:lib && bun run build:cli",
    "build:lib": "bun build ./src/index.ts --target browser --format esm --outdir=dist --minify --sourcemap=linked",
    "build:cli": "bun build ./src/cli.ts --target bun --outdir=dist --minify --sourcemap=linked",
    "build:binary": "bun run scripts/build-binaries.ts",
    "build:binaries": "bun run scripts/build-binaries.ts --all",
    "test:package": "bun run scripts/test-package.ts",
    "prepack": "bun run build"
  },
  "keywords": [
    "lenguaje de programación",
    "español",
    "educación",
    "intérprete"
  ],
  "author": "Uriel Curiel",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UrielCuriel/codexivo.git"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3"
  },
  "packageManager": "bun@1.4.4",
  "bin": {
    "codexivo": "./dist/cli.js"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
